<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Guards the DB_CHANGED broadcast between the app's own processes. Named after the application
      id (app.selfwatch.permission.INTERNAL in the release app) so the debug build, which has its own
      id, can be installed beside it. DbChanges builds the same name from the package at run time.
    -->
    <permission
        android:name="${applicationId}.permission.INTERNAL"
        android:protectionLevel="signature"
        tools:ignore="SystemPermissionTypo" />

    <uses-permission
        android:name="${applicationId}.permission.INTERNAL"
        tools:ignore="SystemPermissionTypo" />
</manifest>
