<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Barcode scanning only; asked for on the first scan (COMPATIBILITY: food row). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The fasting timer notification (WP-11 FastService). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Tablets without a camera still install; the scan screen falls back to manual entry. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
</manifest>
