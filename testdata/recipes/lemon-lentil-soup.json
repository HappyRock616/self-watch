  "recipeCuisine": ["Mediterranean"],
  "keywords": "lentils, quick, vegetarian",
  "recipeIngredient": [
    "1 cup red lentils, rinsed",
    "1 onion, diced",
    "2 cloves garlic, minced",
    "1 tbsp olive oil",
    "5 cups vegetable stock",
    "½ tsp ground cumin",
    "1 lemon, juiced"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToSection",
      "name": "Base",
      "itemListElement": [
        {"@type": "HowToStep", "text": "Warm the oil in a pot and soften the onion for 5 minutes."},
        {"@type": "HowToStep", "text": "Add the garlic and cumin and stir for 1 minute."}
      ]
    },
    {
      "@type": "HowToSection",
      "name": "Simmer",
      "itemListElement": [
        {"@type": "HowToStep", "text": "Add lentils and stock, then simmer for 20 minutes."},
        {"@type": "HowToStep", "text": "Stir in the lemon juice and season to taste."}
      ]
    }
  ],
