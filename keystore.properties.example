# Copy to keystore.properties (git-ignored) to sign release builds locally. Never commit the real file.
# Paths are relative to the repo root. Or set environment variables instead:
# SELFWATCH_KEYSTORE, SELFWATCH_KEYSTORE_PASSWORD, SELFWATCH_KEY_ALIAS, SELFWATCH_KEY_PASSWORD
storeFile=keys/selfwatch-release.jks
storePassword=
keyAlias=selfwatch
keyPassword=
