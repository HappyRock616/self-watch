    <string name="privacy_today_title">Today</string>
    <string name="privacy_promise_title">Our promise</string>
    <string-array name="privacy_promises">
        <item>No account, no ads, no analytics, no crash reports sent anywhere.</item>
        <item>Your health data stays on this phone unless you export it.</item>
        <item>Every internet feature has its own switch in the Privacy center, and most start off.</item>
        <item>Every request is listed in Network activity: when, where, and how much.</item>
        <item>Food data can be loaded from a file, so the internet can stay off completely.</item>
    </string-array>
