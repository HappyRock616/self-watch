<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom tab label: the accent as readable small text when selected, muted otherwise. The icon
     (tab_item) keeps the exact theme color. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/swColorAccentText" android:state_checked="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
