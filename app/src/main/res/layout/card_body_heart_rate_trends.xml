<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: 30-day resting and daily average heart rate lines with chips (HeartRateTrendsCard). -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heart_rate_trends_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_heart_rate_trends">

    <TextView
        android:id="@+id/hrt_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Body" />

    <app.selfwatch.ui.charts.OverlayChartView
        android:id="@+id/hrt_chart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1" />

    <app.selfwatch.ui.components.ToggleChipGroup
        android:id="@+id/hrt_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1" />

    <TextView
        android:id="@+id/hrt_readout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />

    <TextView
        android:id="@+id/hrt_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />

    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/hrt_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/hrt_empty" />
</app.selfwatch.ui.components.SwCard>
