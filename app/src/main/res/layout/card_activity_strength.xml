<?xml version="1.0" encoding="utf-8"?>
<!-- Activity card: strength (and balance) days this week (StrengthSessionsCard). -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/strength_card"
    style="@style/Widget.SelfWatch.TabCard"
    app:swTitle="@string/card_strength_sessions">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/ss_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swValue="@string/dash" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/ss_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp" />

    <TextView
        android:id="@+id/ss_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:textAppearance="@style/TextAppearance.SelfWatch.Body" />

    <TextView
        android:id="@+id/ss_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />

    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/ss_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/ss_empty" />
</app.selfwatch.ui.components.SwCard>
