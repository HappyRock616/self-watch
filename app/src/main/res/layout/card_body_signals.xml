<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: body signals (BodySignalsCard), card design standard: a mini range bar per signal with up / ok. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/body_signals_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_body_signals">

    <LinearLayout
        android:id="@+id/body_signals_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/body_signals_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/signals_card_empty" />
</app.selfwatch.ui.components.SwCard>
