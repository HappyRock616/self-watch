<?xml version="1.0" encoding="utf-8"?>
<!-- A detail screen: top bar with an up arrow, then a scrolling column (filled in code). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SelfWatch.TabToolbar"
        app:navigationContentDescription="@string/detail_back"
        app:navigationIcon="@drawable/ic_back" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <app.selfwatch.shell.MaxWidthLinearLayout
            android:id="@+id/detail_column"
            style="@style/Widget.SelfWatch.TabColumn"
            android:paddingBottom="@dimen/sw_space_3" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
