<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: stress today (BodyStressCard), card design standard: gauge, day strip, split bar. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/body_stress_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_body_stress">

    <app.selfwatch.ui.components.ArcGaugeView
        android:id="@+id/body_stress_gauge"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_gauge_height" />
    <app.selfwatch.ui.components.DayStripView
        android:id="@+id/body_stress_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.SplitBarView
        android:id="@+id/body_stress_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/body_stress_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/stress_card_empty" />
</app.selfwatch.ui.components.SwCard>
