<?xml version="1.0" encoding="utf-8"?>
<!-- Activity card: heart-rate recovery after the latest workout, last 10 workouts (RecoveryHrCard). -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recovery_hr_card"
    style="@style/Widget.SelfWatch.TabCard"
    app:swTitle="@string/card_recovery_hr">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/rhr_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swValue="@string/dash" />

    <TextView
        android:id="@+id/rhr_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Body" />

    <TextView
        android:id="@+id/rhr_workout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />

    <app.selfwatch.ui.components.Sparkline
        android:id="@+id/rhr_spark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/body_spark_height"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/rhr_trend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />

    <TextView
        android:id="@+id/rhr_explain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Body" />

    <TextView
        android:id="@+id/rhr_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />

    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/rhr_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/rhr_empty_none" />
</app.selfwatch.ui.components.SwCard>
