<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: sleep, resting heart rate and HRV as three icon tiles (RecoveryCard), card design standard: icon and number only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recovery_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/sw_space_2"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <app.selfwatch.ui.components.SwCard
        android:id="@+id/sleep_card"
        style="@style/Widget.SelfWatch.TabCard.Third"
        android:layout_marginTop="0dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/sleep_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/body1_ic_sleep" />
        <app.selfwatch.ui.components.StatTile
            android:id="@+id/sleep_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sw_space_half"
            android:importantForAccessibility="no"
            app:swValue="@string/dash" />
    </app.selfwatch.ui.components.SwCard>

    <app.selfwatch.ui.components.SwCard
        android:id="@+id/rest_hr_card"
        style="@style/Widget.SelfWatch.TabCard.Third"
        android:layout_marginTop="0dp"
        android:layout_marginStart="@dimen/tab_card_gap"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/rest_hr_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/body1_ic_heart" />
        <app.selfwatch.ui.components.StatTile
            android:id="@+id/rest_hr_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sw_space_half"
            android:importantForAccessibility="no"
            app:swValue="@string/dash" />
    </app.selfwatch.ui.components.SwCard>

    <app.selfwatch.ui.components.SwCard
        android:id="@+id/hrv_card"
        style="@style/Widget.SelfWatch.TabCard.Third"
        android:layout_marginTop="0dp"
        android:layout_marginStart="@dimen/tab_card_gap"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/hrv_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/body1_ic_hrv" />
        <app.selfwatch.ui.components.StatTile
            android:id="@+id/hrv_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sw_space_half"
            android:importantForAccessibility="no"
            app:swValue="@string/dash" />
    </app.selfwatch.ui.components.SwCard>
</LinearLayout>
