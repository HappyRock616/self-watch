<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: body fat trend (BodyFatCard). -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/body_fat_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_body_fat">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/body_fat_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swLabel="@string/card_body_fat"
        app:swValue="@string/dash" />

    <TextView
        android:id="@+id/body_fat_change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Body" />
    <app.selfwatch.ui.components.Sparkline
        android:id="@+id/body_fat_spark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/body_spark_height"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/body_fat_note"
        android:text="@string/body_fat_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/body_fat_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/body_fat_empty" />
</app.selfwatch.ui.components.SwCard>
