<?xml version="1.0" encoding="utf-8"?>
<!-- Activity card: today's steps, active minutes and active calories against the goals (TodayRingsCard). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/today_rings_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <app.selfwatch.ui.components.SwCard
        style="@style/Widget.SelfWatch.TabCard.Third"
        android:layout_marginTop="0dp">

        <app.selfwatch.ui.components.RingView
            android:id="@+id/ring_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </app.selfwatch.ui.components.SwCard>

    <app.selfwatch.ui.components.SwCard
        style="@style/Widget.SelfWatch.TabCard.Third"
        android:layout_marginStart="@dimen/tab_card_gap"
        android:layout_marginTop="0dp">

        <app.selfwatch.ui.components.RingView
            android:id="@+id/ring_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:swColor="?attr/colorSecondary" />
    </app.selfwatch.ui.components.SwCard>

    <app.selfwatch.ui.components.SwCard
        style="@style/Widget.SelfWatch.TabCard.Third"
        android:layout_marginStart="@dimen/tab_card_gap"
        android:layout_marginTop="0dp">

        <app.selfwatch.ui.components.RingView
            android:id="@+id/ring_kcal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </app.selfwatch.ui.components.SwCard>
</LinearLayout>
