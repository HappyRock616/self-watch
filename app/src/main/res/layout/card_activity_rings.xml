<?xml version="1.0" encoding="utf-8"?>
<!-- Activity card: today's steps, active minutes and active calories as three rings (TodayRingsCard), card design standard. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/today_rings_card"
    style="@style/Widget.SelfWatch.TabCard"
    app:swTitle="@string/card_today_rings">
    <app.selfwatch.ui.components.RingRowView
        android:id="@+id/rings_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/rings_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/trend_empty" />
</app.selfwatch.ui.components.SwCard>
