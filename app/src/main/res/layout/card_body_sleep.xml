<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: last night's sleep (SleepCard), card design standard: big duration, stage timeline, split bar of stages. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sleep_night_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_sleep">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/sleep_night_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:swLabel="@string/sleep_card_last_night"
        app:swValue="@string/dash" />
    <app.selfwatch.body.cards.SleepStagesView
        android:id="@+id/sleep_night_timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.SplitBarView
        android:id="@+id/sleep_night_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/sleep_night_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/sleep_card_empty" />
</app.selfwatch.ui.components.SwCard>
