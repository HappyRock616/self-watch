<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: breathing rate (BreathingRateCard), card design standard: number and a range bar of your usual. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/breathing_rate_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_breathing_rate">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/br_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:swValue="@string/dash" />
    <app.selfwatch.ui.components.RangeBarView
        android:id="@+id/br_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/br_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/br_empty" />
</app.selfwatch.ui.components.SwCard>
