<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: live or latest heart rate (HeartRateNowCard), card design standard: number and a 24-hour trend line. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heart_rate_now_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_heart_rate_now">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/hrn_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:swValue="@string/dash" />
    <app.selfwatch.ui.components.TrendLineView
        android:id="@+id/hrn_trend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/hrn_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/hrn_empty" />
</app.selfwatch.ui.components.SwCard>
