<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: weight (WeightCard), card design standard: the trend number and a trend line with the goal. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/weight_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swActionText="@string/body_log"
    app:swTitle="@string/body_weight">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/weight_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swValue="@string/dash" />

    <app.selfwatch.cards.PictureFrame
        android:id="@+id/weight_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1" />

    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/weight_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/weight_empty" />
</app.selfwatch.ui.components.SwCard>
