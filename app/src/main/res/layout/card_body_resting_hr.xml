<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: resting heart rate, 4-week rolling against the user's usual (RestingHrCard). -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resting_hr_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_resting_hr">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/resting_hr_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swLabel="@string/rhr_card_label"
        app:swValue="@string/dash" />

    <TextView
        android:id="@+id/resting_hr_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Body" />
    <TextView
        android:id="@+id/resting_hr_usual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />
    <app.selfwatch.ui.components.Sparkline
        android:id="@+id/resting_hr_spark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/body_spark_height"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/resting_hr_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/rhr_card_empty" />
</app.selfwatch.ui.components.SwCard>
