<?xml version="1.0" encoding="utf-8"?>
<!-- Activity card: active days this week as day dots (ActiveDaysCard), card design standard. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/active_days_card"
    style="@style/Widget.SelfWatch.TabCard"
    app:swTitle="@string/card_active_days">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/ad_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swValue="@string/dash" />
    <app.selfwatch.ui.components.DotsView
        android:id="@+id/ad_dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/ad_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/ad_empty" />
</app.selfwatch.ui.components.SwCard>
