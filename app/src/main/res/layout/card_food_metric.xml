<?xml version="1.0" encoding="utf-8"?>
<!-- Food card: one number and one picture (card design standard), or an empty state (FoodMetricView). -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SelfWatch.TabCard"
    android:focusable="true">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/metric_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swValue="@string/dash" />

    <app.selfwatch.cards.PictureFrame
        android:id="@+id/metric_picture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:visibility="gone" />

    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/metric_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</app.selfwatch.ui.components.SwCard>
