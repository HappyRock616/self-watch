<?xml version="1.0" encoding="utf-8"?>
<!-- Food card: calories in vs out (EnergyCard), card design standard: the number and the week as bars. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/energy_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:layout_marginTop="0dp"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/body_energy_today">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/energy_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swValue="@string/dash" />

    <app.selfwatch.cards.PictureFrame
        android:id="@+id/energy_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1" />

    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/energy_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/body_energy_empty" />
</app.selfwatch.ui.components.SwCard>
