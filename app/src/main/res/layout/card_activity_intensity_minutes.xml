<?xml version="1.0" encoding="utf-8"?>
<!-- Activity card: intensity minutes this week, bars per day with the daily share (IntensityMinutesCard), card design standard. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/intensity_minutes_card"
    style="@style/Widget.SelfWatch.TabCard"
    app:swTitle="@string/card_intensity_minutes">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/im_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swValue="@string/dash" />
    <app.selfwatch.ui.components.BarsView
        android:id="@+id/im_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/im_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/im_empty" />
</app.selfwatch.ui.components.SwCard>
