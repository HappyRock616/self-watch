<?xml version="1.0" encoding="utf-8"?>
<!-- Body card: overnight HRV 7-day average against the user's usual band (HrvBaselineCard). -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hrv_baseline_card"
    style="@style/Widget.SelfWatch.TabCard"
    android:clickable="true"
    android:focusable="true"
    app:swTitle="@string/card_hrv_baseline">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/hrv_baseline_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swLabel="@string/hrv_card_label"
        app:swValue="@string/dash" />

    <TextView
        android:id="@+id/hrv_baseline_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Body" />
    <TextView
        android:id="@+id/hrv_baseline_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />
    <app.selfwatch.ui.components.Sparkline
        android:id="@+id/hrv_baseline_spark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/body_spark_height"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/hrv_baseline_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_half"
        android:textAppearance="@style/TextAppearance.SelfWatch.Caption" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/hrv_baseline_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/hrv_card_within" />
</app.selfwatch.ui.components.SwCard>
