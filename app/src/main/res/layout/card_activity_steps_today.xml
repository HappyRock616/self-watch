<?xml version="1.0" encoding="utf-8"?>
<!-- Activity card: steps today, week bars with the goal line (StepsTodayCard), card design standard. -->
<app.selfwatch.ui.components.SwCard xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/steps_today_card"
    style="@style/Widget.SelfWatch.TabCard"
    app:swTitle="@string/card_steps_today">

    <app.selfwatch.ui.components.StatTile
        android:id="@+id/st_tile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swValue="@string/dash" />
    <app.selfwatch.ui.components.BarsView
        android:id="@+id/st_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sw_space_1"
        android:importantForAccessibility="no" />
    <app.selfwatch.ui.components.EmptyState
        android:id="@+id/st_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:swMessage="@string/st_empty" />
</app.selfwatch.ui.components.SwCard>
