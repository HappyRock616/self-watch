<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the component gallery (task C03), with its own launcher entry, and the demo
     data screen (exported so adb can start it: am start -n app.selfwatch.debug/app.selfwatch.demo.DemoActivity). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".gallery.GalleryActivity"
            android:exported="true"
            android:label="@string/gallery_label"
            android:taskAffinity="app.selfwatch.gallery"
            android:theme="@style/Theme.SelfWatch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Sample food data for screenshots; only adb shell (DUMP permission) can send it. -->
        <receiver
            android:name=".food.FoodSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.selfwatch.debug.SEED_FOOD" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".demo.DemoActivity"
            android:exported="true"
            android:label="@string/demo_label"
            android:theme="@style/Theme.SelfWatch" />
    </application>
</manifest>
