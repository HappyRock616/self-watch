<?xml version="1.0" encoding="utf-8"?>
<!-- Self Watch color tokens, light palette. The dark palette (the default look) is in values-night.
     See docs/build-plan/WP-09-ui.md. -->
<resources>
    <!-- Color themes (the Just Go 5K themes), one set per theme, used by ThemeOverlay.SelfWatch.Theme.*.
         Worked out by app.selfwatch.ui.ThemeColors (ThemeColorsTest checks these match):
         primary / secondary / on_*: exactly Just Go 5K's colors (Theme.mc), the same as the dark look;
         accent_text: primary as small text: the primary when it reaches 4.5:1 on every surface, else
         Just Go 5K's dark text-on color, else the normal text color (never a darkened theme color);
         accent_text_inverse: primary as text on the inverse surface (snackbar action). -->
