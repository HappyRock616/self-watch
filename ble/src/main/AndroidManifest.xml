<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth LE is the point of a watch companion (support policy: any phone with Bluetooth LE). -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- Pairing goes only through the Companion Device Manager (no location, no scan permission). -->
    <uses-feature android:name="android.software.companion_device_setup" android:required="true" />

    <!-- API 26–30: install-time Bluetooth permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- API 31+: runtime permission to connect. No BLUETOOTH_SCAN: the CDM scans for us. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Granted with the CDM association. -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />

</manifest>
